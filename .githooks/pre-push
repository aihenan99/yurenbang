#!/bin/sh
# ============================================================================
# 育人帮 · 推送前门禁（pre-push）
#
# 在 pre-commit 的基础上多查一项：部署包是否与源码同步（漂移检测）。
# 这一项很关键——改了源码却忘了同步，部署上去等于没改，而且很难发现。
#
# 安装：npm run hooks
# 临时绕过：git push --no-verify
# ============================================================================

cd "$(git rev-parse --show-toplevel)" || exit 1

if ! command -v node >/dev/null 2>&1; then
  echo "[pre-push] 未找到 node，跳过检查"
  exit 0
fi

node scripts/verify.mjs
if [ $? -ne 0 ]; then
  echo ""
  echo "────────────────────────────────────────────────"
  echo " 推送被拦下：先修好上面的问题。"
  echo " 若只是部署包未同步，执行：npm run sync"
  echo "────────────────────────────────────────────────"
  exit 1
fi
