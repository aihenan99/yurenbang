{
  "name": "yurenbang",
  "version": "0.2.0",
  "private": true,
  "description": "育人帮 · 家长互助社区（静态前端 + Cloudflare Pages Worker 代理 + 平台云服务）",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "verify:fast": "node scripts/verify.mjs --fast",
    "verify:e2e": "node scripts/verify.mjs --e2e",
    "serve": "python -m http.server 8796 --bind 127.0.0.1 --directory yurenbang-app",
    "audit:state": "node scripts/state-audit.mjs",
    "sync": "python temp/sync_deploy.py",
    "sync:check": "python temp/sync_deploy.py --check",
    "deploy": "python temp/release.py",
    "hooks": "git config core.hooksPath .githooks",
    "verify:csp": "node scripts/csp-rehearsal.mjs",
    "audit:deps": "npm install --package-lock-only --ignore-scripts && npm audit --audit-level=high",
    "privacy:audit": "node scripts/privacy-audit.mjs"
  },
  "comment": "本文件没有 npm 依赖：所有工具都是 Node 内置模块 + 项目自带 Playwright（temp/pw）。这样不会引入 node_modules，交接时 clone 即可用。",
  "license": "UNLICENSED"
}
